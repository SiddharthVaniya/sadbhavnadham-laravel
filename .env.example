APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Daily Excel of yesterday's donations at 01:00 Asia/Kolkata. Comma-separated; first = To, rest = Cc.
DONATION_DAILY_REPORT_EMAILS=siddharthvaniya123@gmail.com

DONATION_CERTIFICATE_ENABLED=true
# English sanman patra artwork is uploaded per cause on Admin → Causes → WhatsApp tab.
# DONATION_CERTIFICATE_DATE_PREFIX_ENGLISH="Date : "
# Certificate donor name styling
# DONATION_CERTIFICATE_NAME_SIZE_PT=90
# Auto-shrink long names (optional tuning)
# DONATION_CERTIFICATE_NAME_MIN_SIZE_PT=32
# DONATION_CERTIFICATE_NAME_MAX_WIDTH_PERCENT=82
# DONATION_CERTIFICATE_NAME_FONT_WEIGHT=700
# Legacy boolean alias: DONATION_CERTIFICATE_NAME_BOLD=true (same as 700)
# DONATION_CERTIFICATE_NAME_COLOR="#840405"
# Or without hash (dotenv treats unquoted #840405 as a comment):
# DONATION_CERTIFICATE_NAME_COLOR=840405
# DONATION_CERTIFICATE_DATE_COLOR="#ffffff"
# DONATION_CERTIFICATE_NAME_TOP_PERCENT=60.8
# Public HTTPS base used in certificate/WhatsApp media URLs (must be reachable by AiSensy).
# DONATION_CERTIFICATE_PUBLIC_BASE_URL=https://donate.sadbhavnadham.org
# DONATION_CERTIFICATE_RENDER_DPI=220
# DONATION_CERTIFICATE_WHATSAPP_MAX_WIDTH=1920
# DONATION_CERTIFICATE_WHATSAPP_PREFER_PNG=true
# PDFTOPPM_BINARY=tools/poppler/poppler-24.08.0/Library/bin/pdftoppm.exe

DONATION_BIRTHDAY_NAME_TOP_PERCENT=42.8
DONATION_BIRTHDAY_NAME_SIZE_PT=36
DONATION_BIRTHDAY_NAME_COLOR=#C4A035
DONATION_BIRTHDAY_NAME_UPPERCASE=false
DONATION_BIRTHDAY_NAME_UNDERLINE=false

# Returning-donor OTP autofill (email works by default; WhatsApp needs AiSensy campaign in settings)
# DONATION_OTP_LENGTH=6
# DONATION_OTP_TTL_SECONDS=300
# DONATION_OTP_RESEND_SECONDS=60
# DONATION_OTP_MAX_ATTEMPTS=5
# DONATION_OTP_DAILY_SEND_LIMIT=10
# Settings keys: aisensy_otp_campaign, aisensy_otp_account_id

# AiSensy WhatsApp OTP (authentication template with Copy Code button)
# AISENSY_CAMPAIGN_ENDPOINT=https://backend.aisensy.com/campaign/t1/api/v2
# AISENSY_OTP_API_KEY=
# AISENSY_OTP_CAMPAIGN=login_otp
# AISENSY_OTP_COUNTRY_CODE=91
# AISENSY_OTP_SOURCE="donate website login"

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sadbhavnadonation
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Production HTTPS (donate.sadbhavnadham.org): leave SESSION_SECURE_COOKIE unset
# so Laravel defaults to secure cookies when the request is HTTPS.
# SESSION_SECURE_COOKIE=true
#
# WordPress iframe embeds (sadbhavnadham.org → donate.*): browsers treat the
# iframe as cross-site, so SameSite=lax blocks session/CSRF cookies on form POST.
# Use "none" in production when embedding the donate form in WP; requires HTTPS.
# SESSION_SAME_SITE=none
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
INERTIA_USE_SCRIPT_ELEMENT_FOR_INITIAL_PAGE=true
INERTIA_SSR_ENABLED=false

WP_API_TOKEN=YOUR_WP_API_TOKEN_HERE
# Shared secret for WordPress + Next.js checkout API (X-WP-TOKEN header).
# DONATION_STAFF_VANITY_URLS_ENABLED=false
# Comma-separated Next.js origins allowed to call /api/next-razorpay.
# Attribution is sent in the JSON body; do not rely on cookies across subdomains.
# DONATION_FRONTEND_ORIGINS=https://sadbhavnadham.org,https://www.sadbhavnadham.org,https://dev.sadbhavnadham.org,http://localhost:3000
# Public Next.js origin for staff/Meta share links. Thank-you and admin stay on APP_URL.
DONATION_PUBLIC_FRONTEND_URL=https://sadbhavnadham.org
# 301 Laravel GET / and /donate/{cause} to the Next.js site (query string preserved).
# Enable after the Next.js site is live. Thank-you, checkout POST, /give, and admin stay here.
DONATION_REDIRECT_PUBLIC_DONATE_TO_FRONTEND=true

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_SHEET_ID=
GOOGLE_FAILED_SHEET_ID=1G3BxDAzt0425soT--HvHhfXT70aEGVbZJvZY1_onP7Q

RAZORPAY_KEY=
RAZORPAY_SECRET=
WEBHOOK_SECRET=
# Optional: restrict QR auto-import to these Razorpay QR ids (comma-separated). Empty = any QR.
RAZORPAY_QR_IDS=
RAZORPAY_SUBSCRIPTIONS_ENABLED=false
RAZORPAY_SUBSCRIPTION_MIN_AMOUNT=100
RAZORPAY_SUBSCRIPTION_MAX_AMOUNT=15000
# Max 30 years validity on Razorpay. 360 monthly cycles = 30 years.
RAZORPAY_SUBSCRIPTION_TOTAL_COUNT=360

# Analytics (admin dashboard rollups + geo)
ANALYTICS_ROLLUP_ENABLED=true
ANALYTICS_ADMIN_CACHE_TTL=300
ANALYTICS_GEOLOCATION_ENABLED=true

# Danamojo donation sync (hourly via schedule:run)
DANAMOJO_SYNC_ENABLED=true
DANAMOJO_API_BASE_URL=https://api.danamojo.org
DANAMOJO_API_KEY_SECRET=
DANAMOJO_LOOKBACK_DAYS=3
DANAMOJO_PAGE_SIZE=100
# DANAMOJO_DEFAULT_CAUSE_SLUG=tree-plantation
DANAMOJO_QUEUE_SHEET=true
DANAMOJO_SEND_RECEIPT_EMAIL=false
DANAMOJO_SEND_WHATSAPP=false

# Branding (reuse this app for another NGO by changing env only)
BRAND_NAME="${APP_NAME}"
BRAND_SHORT_NAME=Sadbhavna
