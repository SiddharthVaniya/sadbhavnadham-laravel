BRAND_SOCIAL_WHATSAPP=https://wa.aisensy.com/aab10a
BRAND_UPI_QR=/images/footer/upi-qr.png
BRAND_PAYMENT_GATEWAYS=/images/payments/payment-logos.png
BRAND_BANK_ACCOUNT_NAME="MANAV SEVA CHERITABLE TRUST"
